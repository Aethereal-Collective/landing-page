# Nuxt Studio (content editor at /_studio). Create a GitHub OAuth App with callback:
#   https://aethereal.top/__nuxt_studio/auth/github
NUXT_STUDIO_AUTH_GITHUB_CLIENT_ID=
NUXT_STUDIO_AUTH_GITHUB_CLIENT_SECRET=
# Comma-separated GitHub account emails allowed into the editor. Leave empty and anyone who logs in can open it.
NUXT_STUDIO_AUTH_GITHUB_MODERATORS=
# Random string (32+ chars) that signs editor login sessions. Generate: openssl rand -hex 32
NUXT_STUDIO_AUTH_SESSION_SECRET=
# Pin the OAuth callback so it is right behind the reverse proxy.
NUXT_STUDIO_AUTH_GITHUB_REDIRECT_URL=https://aethereal.top/__nuxt_studio/auth/github
