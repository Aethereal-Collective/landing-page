# Nuxt Studio (content editor at /_studio). nuxt-studio 1.7 reads these STUDIO_* names at runtime.
# GitHub OAuth App callback: https://aethereal.top/__nuxt_studio/auth/github
STUDIO_GITHUB_CLIENT_ID=
STUDIO_GITHUB_CLIENT_SECRET=
# Comma-separated GitHub account emails allowed into the editor. Empty = anyone who logs in with GitHub.
STUDIO_GITHUB_MODERATORS=
# Pin the OAuth callback so it is right behind the reverse proxy.
STUDIO_GITHUB_REDIRECT_URL=https://aethereal.top/__nuxt_studio/auth/github
# Random string (32+ chars) that signs editor sessions. Generate: openssl rand -hex 32
NUXT_STUDIO_AUTH_SESSION_SECRET=
